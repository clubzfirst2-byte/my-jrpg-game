{
  "name": "my-jrpg-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "2D top-down open-world action adventure for the browser (iPhone first)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run check:data && npm run test && npm run test:e2e",
    "check:data": "node tools/validate-data.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
