{
  "version": 1,
  "dialogues": {
    "elder": {
      "name": "長老",
      "start": [
        {
          "if": [
            {
              "flag": "ending_seen"
            },
            {
              "quest": "lost_charm",
              "state": "done"
            }
          ],
          "goto": "post"
        },
        {
          "if": [
            {
              "flag": "princess_met"
            },
            {
              "flag": "elder_legend",
              "is": false
            },
            {
              "flag": "elder_met"
            },
            {
              "flag": "ending_seen",
              "is": false
            }
          ],
          "goto": "legend"
        },
        {
          "if": [
            {
              "quest": "lost_charm",
              "state": "done"
            }
          ],
          "goto": "thanks"
        },
        {
          "if": [
            {
              "quest": "lost_charm",
              "state": "ready"
            }
          ],
          "goto": "found"
        },
        {
          "if": [
            {
              "quest": "lost_charm",
              "state": "active"
            }
          ],
          "goto": "waiting"
        },
        {
          "if": [
            {
              "flag": "elder_met"
            }
          ],
          "goto": "ask"
        },
        {
          "if": [
            {
              "flag": "ending_seen"
            }
          ],
          "goto": "intro_after"
        },
        {
          "goto": "intro"
        }
      ],
      "nodes": {
        "intro": {
          "text": [
            "よく来たな、旅の人。ここは風見の村じゃ。",
            "島から渡ってきたのか？ あの砂の道を歩いてくるとは、たいしたものじゃ。"
          ],
          "effects": [
            {
              "setFlag": "elder_met"
            }
          ],
          "next": "ask"
        },
        "ask": {
          "text": [
            "……実は困っておってな。荒野を旅したときに、大事なお守りを落としてしもうた。",
            "オアシスの近くで休んだのが最後じゃ。探してきてはくれんか？"
          ],
          "choices": [
            {
              "label": "引き受ける",
              "effects": [
                {
                  "startQuest": "lost_charm"
                }
              ],
              "goto": "accepted"
            },
            {
              "label": "また今度",
              "goto": "later"
            }
          ]
        },
        "accepted": {
          "text": [
            "ありがたい！ 荒野は暑いぞ。水と食べ物を忘れずにな。"
          ]
        },
        "later": {
          "text": [
            "そうか……気が向いたら頼む。"
          ]
        },
        "waiting": {
          "text": [
            "お守りは見つかったかの？ オアシスの近くじゃよ。"
          ]
        },
        "found": {
          "text": [
            "おお、それじゃ！ 本当にありがとう。",
            "これは礼じゃ。星の欠片という、不思議な石じゃよ。"
          ],
          "effects": [
            {
              "completeQuest": "lost_charm"
            }
          ],
          "next": "thanks"
        },
        "thanks": {
          "text": [
            "お守りが戻って、村の風も穏やかになった気がするわい。"
          ]
        },
        "legend": {
          "text": [
            "……おや。お前さんの胸の石、新月の夜の星のように、強く光っておるな。",
            "灯の民の言い伝えでは、星環には対の守り手がおるそうじゃ。星を読む『姫』と、星脈を歩く『歩き手』。",
            "姫の額には星の形の青い石、歩き手の胸にも同じ石。……さて、お前さんはどっちかのう。ほっほ。"
          ],
          "effects": [
            {
              "setFlag": "elder_legend"
            }
          ]
        },
        "post": {
          "text": [
            "星脈の風が、村まで届いておる。新月の夜からこっち、みなが待っておった風じゃ。",
            "まさか姫さまを連れて帰ってくるとはのう。長生きはするもんじゃ。"
          ]
        },
        "intro_after": {
          "text": [
            "おお、お前さんか。霧が晴れて、村に風が戻ってきたわい。",
            "わしは風見の村の長老じゃ。……せっかくじゃ、ひとつ頼まれてくれんか。"
          ],
          "effects": [
            {
              "setFlag": "elder_met"
            }
          ],
          "next": "ask"
        }
      }
    },
    "cook": {
