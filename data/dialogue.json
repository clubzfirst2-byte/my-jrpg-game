              "quest": "star_ring_call",
              "state": "active"
            },
            {
              "cores": 2
            }
          ],
          "goto": "two"
        },
        {
          "if": [
            {
              "quest": "star_ring_call",
              "state": "active"
            },
            {
              "cores": 1
            }
          ],
          "goto": "one"
        },
        {
          "if": [
            {
              "quest": "star_ring_call",
              "state": "active"
            }
          ],
          "goto": "waiting"
        },
        {
          "if": [
            {
              "flag": "princess_met"
            }
          ],
          "goto": "ask"
        },
        {
          "goto": "intro"
        }
      ],
      "nodes": {
        "intro": {
          "text": [
            "……よかった。ちゃんと、届いていたのですね。",
            "わたしの姿が透けて見えるでしょう？ これは写し身。本当のわたしは、大陸の真ん中の星環に残っています。輪の中から、裏返る力を少しだけ押さえているのです。",
            "あなたの胸の石と、わたしの額の石。二つで一つの『星環の要石』。わたしたちは、星環を守る対の守り手でした。",
            "……覚えていないのですね。あの夜、あなたは自分の記憶を要石に注いで、ここまで跳んだのです。止める間もありませんでした。"
          ],
          "effects": [
            {
              "setFlag": "princess_met"
            }
          ],
          "next": "ask"
        },
        "ask": {
          "text": [
            "この前の新月の夜、淀みが大陸の真ん中の星環に取りついて、輪を裏返しました。",
            "裏返った輪は、星脈を吸いこむ渦になった。それが『淀みの源』です。輪の四つの座から伸びた根が、森・山・荒野・湖で『澱の核』になっています。",
            "四つの根を断てば、輪に近づけます。……もう一度、いっしょに歩いてくれますか？"
          ],
          "choices": [
            {
              "label": "うなずく",
              "effects": [
                {
                  "startQuest": "star_ring_call"
                }
              ],
              "goto": "accepted"
            },
            {
              "label": "胸の石を見る",
              "goto": "why"
            }
          ]
        },
        "why": {
          "text": [
            "その石は、あなたの石です。だれかに持たされたのではなく、あなたが自分で選んで持っていたもの。",
            "記憶は戻らないかもしれません。それでも、あなたの足は道を覚えているはずです。"
          ],
          "choices": [
            {
              "label": "うなずく",
              "effects": [
                {
                  "startQuest": "star_ring_call"
                }
              ],
              "goto": "accepted"
            },
            {
              "label": "目をそらす",
              "goto": "later"
            }
          ]
        },
        "later": {
          "text": [
            "……いいのです。記録石のある所なら、わたしはどこにでも姿を出せます。心が決まったら、また。"
          ]
        },
        "accepted": {
          "text": [
            "ありがとう。記録石は、星環のかけらから作られています。旅の途中でも、石のそばに来ればわたしと話せます。",
            "まずは、浜から続く砂の道を南へ。風の草原に、風見の村があります。"
          ]
        },
        "waiting": {
          "text": [
            "四つの核は、森・山・荒野・湖にあります。黒い霧が濃いほうへ向かってください。",
            "疲れたら、宿で休んでください。写し身でも、それくらいはわかります。"
          ]
        },
        "one": {
          "text": [
            "一つ目の根が断たれました。輪の座が一つ、もとの色に戻ったのを感じます。",
            "……ほら、わたしの姿も、少しはっきりしたでしょう？"
          ]
        },
        "two": {
          "text": [
            "核が二つ、浄化されました。裏返った輪が、きしんでいます。",
            "残った根は暴れているかもしれません。気をつけて。"
          ]
        },
        "three": {
          "text": [
            "あと一つです。",
            "最後の根を断ったら、記録石のそばに来てください。"
          ]
        },
        "all_cores": {
          "text": [
            "四つの根が、すべて断たれました。胸の石が、わたしの石と同じ音で鳴っていますね。",
            "あなたが目覚めた浜の、小さな星環。あれは大陸の真ん中の輪と、星脈でつながっています。いま、門として開きました。",
            "源は、裏返った星環そのものです。輪のまわりの四つの座を、もとの向きに戻してください。そうすれば、輪の目が開きます。"
          ],
          "effects": [
            {
              "completeQuest": "star_ring_call"
            },
            {
              "startQuest": "source_of_murk"
            },
            {
              "setFlag": "source_open"
            }
          ],
          "next": "go_source"
        },
        "go_source": {
          "text": [
            "浜の星環が開いています。輪の中へ歩いていけば、源の前に出ます。",
            "四つの座は、火・光・重さ・響きで目を覚まします。あなたがこれまでに覚えた力を、全部使って。"
          ]
        },
        "home_joined": {
          "text": [
