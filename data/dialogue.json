      "nodes": {
        "intro": {
          "text": [
            "見張りの俺は村を離れられない。",
            "東の丘の風車跡に、変わったことがないか見てきてくれないか？"
          ],
          "choices": [
            {
              "label": "見てくる",
              "effects": [
                {
                  "startQuest": "windmill_watch"
                }
              ],
              "goto": "ok"
            },
            {
              "label": "断る",
              "goto": "no"
            }
          ]
        },
        "ok": {
          "text": [
            "助かる。丘の上の古い風車だ。高い所からならすぐ見つかる。"
          ]
        },
        "no": {
          "text": [
            "そうか。"
          ]
        },
        "waiting": {
          "text": [
            "風車跡は東の丘の上だ。"
          ]
        },
        "ready": {
          "text": [
            "見てきてくれたか！ 異常なしなら一安心だ。",
            "礼に矢を持っていけ。"
          ],
          "effects": [
            {
              "completeQuest": "windmill_watch"
            }
          ],
          "next": "done"
        },
        "done": {
          "text": [
            "今日も村は平和だ。"
          ]
        },
        "done_cores": {
          "text": [
            "このごろ、遠くの黒い霧が薄くなった気がする。",
            "……お前の仕業か？ なら、礼を言わないとな。"
          ]
        },
        "post": {
          "text": [
            "見張り台から、遠くの山まで見える。",
            "霧がないってのは、いいもんだな。"
          ]
        },
        "done_hint": {
          "text": [
            "そういえば、島の浜の記録石のあたりが、夜に青く光るのを見たぞ。",
            "何だろうな。お前、島から来たんだろう？"
          ]
        },
        "intro_after": {
          "text": [
            "霧が晴れて、見張りも少しは楽になった。",
            "それでも東の丘の風車跡は気になる。見てきてくれないか？"
          ],
          "choices": [
            {
              "label": "見てくる",
              "effects": [
                {
                  "startQuest": "windmill_watch"
                }
              ],
              "goto": "ok"
            },
            {
              "label": "断る",
              "goto": "no"
            }
          ]
        }
      }
