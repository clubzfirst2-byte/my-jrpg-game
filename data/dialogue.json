      "nodes": {
        "intro": {
          "text": [
            "いらっしゃい！ ……と言いたいところだけど、肉が切れちまってね。",
            "獣の肉を 3 つ持ってきてくれたら、自慢の煮込みをごちそうするよ。"
          ],
          "choices": [
            {
              "label": "持ってくる",
              "effects": [
                {
                  "startQuest": "meat_for_cook"
                }
              ],
              "goto": "ok"
            },
            {
              "label": "今は無理",
              "goto": "no"
            }
          ]
        },
        "ok": {
          "text": [
            "頼んだよ！ 草原の獣なら、よく肉を落とすよ。"
          ]
        },
        "no": {
          "text": [
            "気が向いたらでいいよ。"
          ]
        },
        "waiting": {
          "text": [
            "肉は 3 つだよ。草原の獣を探してごらん。"
          ]
        },
        "ready": {
          "text": [
            "おっ、いい肉だね！ さっそく煮込むよ。",
            "はい、狩人の煮込み。食べると力がわくよ！"
          ],
          "effects": [
            {
              "completeQuest": "meat_for_cook"
            }
          ],
          "next": "done"
        },
        "done": {
          "text": [
            "また腹が減ったら寄っておくれ。"
          ]
        },
        "feast": {
          "text": [
            "おや、おかえり！ 霧が晴れたお祝いだ、今日の鍋は特別だよ。",
            "ほら、狩人の煮込み。お代はいらないよ！"
          ],
          "effects": [
            {
              "setFlag": "cook_feast"
            },
            {
              "giveItem": "hunter_stew",
              "count": 1
            }
          ]
        },
        "intro_after": {
          "text": [
            "いらっしゃい！ 霧が晴れてから、宿も大にぎわいさ。",
            "……ところが肉が切れちまってね。獣の肉を 3 つ持ってきてくれたら、自慢の煮込みをごちそうするよ。"
          ],
          "choices": [
            {
              "label": "持ってくる",
              "effects": [
                {
                  "startQuest": "meat_for_cook"
                }
              ],
              "goto": "ok"
            },
            {
              "label": "今は無理",
              "goto": "no"
            }
          ]
        }
      }
    },
